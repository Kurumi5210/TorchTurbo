     """Bound the output ring by the aligned size of all active moment pairs."""
-    half = sum(DeviceWorkspace.align(max(param.exp_avg.nbytes, param.exp_avg_sq.nbytes))
-               for param in bound)
-    return min(capacity, 2 * half)
+    return min(capacity, single_chunk_slot_bytes(bound))
 
 
